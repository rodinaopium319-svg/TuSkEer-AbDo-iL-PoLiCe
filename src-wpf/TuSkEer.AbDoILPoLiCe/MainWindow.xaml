<Window x:Class="TuSkEer.AbDoILPoLiCe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:TuSkEer.AbDoILPoLiCe.ViewModels"
        xmlns:models="clr-namespace:TuSkEer.AbDoILPoLiCe.Models"
        xmlns:controls="clr-namespace:TuSkEer.AbDoILPoLiCe.Controls"
        Title="TuSkEer AbDo iL PoLiCe"
        Width="1360"
        Height="820"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/Resources/app_icon.ico">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="68"
                            CornerRadius="16"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Margin="6"
            CornerRadius="16"
            BorderThickness="1.2"
            BorderBrush="{StaticResource WindowFrameBorderBrush}"
            ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F2040814" Offset="0.0" />
                <GradientStop Color="#EB081229" Offset="0.52" />
                <GradientStop Color="#F20B0F26" Offset="1.0" />
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <!-- Ambient Neon Edge Glows -->
            <Ellipse Width="520" Height="360" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-160,-140,0,0" IsHitTestVisible="False" Opacity="0.22">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#00D4FF" Offset="0" />
                        <GradientStop Color="#0000D4FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="500" Height="380" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-140,-120" IsHitTestVisible="False" Opacity="0.20">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#EF4444" Offset="0" />
                        <GradientStop Color="#00EF4444" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="420" Height="320" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                     Margin="0,0,0,-130" IsHitTestVisible="False" Opacity="0.16">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#8B5CF6" Offset="0" />
                        <GradientStop Color="#008B5CF6" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Tasteful Atmospheric Owner Portrait Silhouette (Right Backdrop) -->
            <Image Source="pack://application:,,,/Resources/owner_portrait.jpg"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Stretch"
                   Stretch="UniformToFill"
                   Width="420"
                   Opacity="0.11"
                   IsHitTestVisible="False">
                <Image.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#00000000" Offset="0.0" />
                        <GradientStop Color="#AA000000" Offset="0.55" />
                        <GradientStop Color="#EE000000" Offset="1.0" />
                    </LinearGradientBrush>
                </Image.OpacityMask>
            </Image>

            <!-- Subtle GPU Particle Layer (Automatically pauses when minimized/hidden) -->
            <controls:ParticleOverlay IsAnimationActive="{Binding EnableBackgroundParticles}" />

            <Grid Margin="18,12,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ================= ROW 0: TOP BAR ================= -->
                <Grid Grid.Row="0" Height="62">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Owner Portrait Avatar + Crown + Brand Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="54" Height="56" Margin="0,0,12,0">
                            <!-- Crown Vector Mark -->
                            <Path Data="M 13,9 L 17,2 L 24,7 L 31,1 L 38,7 L 45,2 L 49,9 Z"
                                  Stroke="#F43F5E" StrokeThickness="1.6" Fill="#33EF4444"
                                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-3,0,0" />
                            <Border Width="48" Height="48" CornerRadius="24" VerticalAlignment="Bottom"
                                    BorderThickness="2" BorderBrush="{StaticResource WindowFrameBorderBrush}">
                                <Border.Clip>
                                    <EllipseGeometry Center="24,24" RadiusX="23" RadiusY="23" />
                                </Border.Clip>
                                <Image Source="pack://application:,,,/Resources/owner_portrait.jpg" Stretch="UniformToFill" />
                            </Border>
                        </Grid>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="TuSkEer " FontSize="20" FontWeight="Bold" Foreground="White" />
                                <TextBlock Text="AbDo " FontSize="20" FontWeight="Bold" Foreground="#F43F5E" />
                                <TextBlock Text="iL PoLiCe" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" />
                            </StackPanel>
                            <TextBlock Text="Auto Typer  ·  Type Smart ... Be Faster"
                                       FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Live Status Badge + Quick Actions + Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Live Engine State Pill -->
                        <Border Background="#990B152F" BorderBrush="#4422C55E" BorderThickness="1"
                                CornerRadius="16" Padding="12,5" Margin="0,0,12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="9" Height="9" Margin="0,0,7,0"
                                         Fill="{Binding Telemetry.State, Converter={StaticResource EngineStateToBrushConverter}}" />
                                <TextBlock Text="{Binding Telemetry.State}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                            </StackPanel>
                        </Border>

                        <!-- Quick Jump Buttons -->
                        <Button Style="{StaticResource GlassButtonStyle}" Margin="0,0,8,0"
                                Command="{Binding NavigateCommand}" CommandParameter="KeyboardShortcuts"
                                Content="Shortcuts" />
                        <Button Style="{StaticResource GlassButtonStyle}" Margin="0,0,16,0"
                                Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                Content="Settings" />

                        <!-- Window Caption Buttons -->
                        <Button Style="{StaticResource GlassButtonStyle}" Width="34" Height="30" Padding="0" Margin="0,0,6,0"
                                Click="MinimizeWindow_Click" ToolTip="Minimize" Content="—" />
                        <Button Style="{StaticResource GlassButtonStyle}" Width="34" Height="30" Padding="0" Margin="0,0,6,0"
                                Click="MaximizeRestore_Click" ToolTip="Maximize / Restore" Content="□" />
                        <Button Style="{StaticResource GlassButtonStyle}" Width="34" Height="30" Padding="0"
                                BorderBrush="#66EF4444"
                                Click="CloseToTray_Click" ToolTip="Hide to System Tray" Content="✕" />
                    </StackPanel>
                </Grid>

                <!-- ================= ROW 1: NAVIGATION TABS ================= -->
                <Border Grid.Row="1" Background="#88091227" BorderBrush="#3338BDF8" BorderThickness="1"
                        CornerRadius="11" Padding="5" Margin="0,6,0,12">
                    <UniformGrid Columns="7">
                        <RadioButton Style="{StaticResource NavTabButtonStyle}" Content="Dashboard"
                                     IsChecked="{Binding ActiveTab, Mode=OneWay, Converter={StaticResource TabEqualityConverter}, ConverterParameter=Dashboard}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Dashboard" />
                        <RadioButton Style="{StaticResource NavTabButtonStyle}" Content="Scripts Library"
                                     IsChecked="{Binding ActiveTab, Mode=OneWay, Converter={StaticResource TabEqualityConverter}, ConverterParameter=ScriptsLibrary}"
                                     Command="{Binding NavigateCommand}" CommandParameter="ScriptsLibrary" />
                        <RadioButton Style="{StaticResource NavTabButtonStyle}" Content="Script Editor"
                                     IsChecked="{Binding ActiveTab, Mode=OneWay, Converter={StaticResource TabEqualityConverter}, ConverterParameter=ScriptEditor}"
                                     Command="{Binding NavigateCommand}" CommandParameter="ScriptEditor" />
                        <RadioButton Style="{StaticResource NavTabButtonStyle}" Content="Keyboard Shortcuts"
                                     IsChecked="{Binding ActiveTab, Mode=OneWay, Converter={StaticResource TabEqualityConverter}, ConverterParameter=KeyboardShortcuts}"
                                     Command="{Binding NavigateCommand}" CommandParameter="KeyboardShortcuts" />
                        <RadioButton Style="{StaticResource NavTabButtonStyle}" Content="Typing Engine"
                                     IsChecked="{Binding ActiveTab, Mode=OneWay, Converter={StaticResource TabEqualityConverter}, ConverterParameter=TypingEngine}"
                                     Command="{Binding NavigateCommand}" CommandParameter="TypingEngine" />
                        <RadioButton Style="{StaticResource NavTabButtonStyle}" Content="Settings"
                                     IsChecked="{Binding ActiveTab, Mode=OneWay, Converter={StaticResource TabEqualityConverter}, ConverterParameter=Settings}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                        <RadioButton Style="{StaticResource NavTabButtonStyle}" Content="About TuSkEer"
                                     IsChecked="{Binding ActiveTab, Mode=OneWay, Converter={StaticResource TabEqualityConverter}, ConverterParameter=About}"
                                     Command="{Binding NavigateCommand}" CommandParameter="About" />
                    </UniformGrid>
                </Border>

                <!-- ================= ROW 2: TAB WORKSPACES ================= -->
                <Grid Grid.Row="2">

                    <!-- 1. DASHBOARD TAB -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="{x:Static vm:NavigationTab.Dashboard}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Top KPI Strip -->
                        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,14">
                            <Border Style="{StaticResource GlassCardStyle}" Padding="16" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Total Saved Scripts" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding TotalScriptsCount}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,4,0,2" />
                                    <TextBlock Text="{Binding EnabledScriptsCount, StringFormat='{}{0} enabled for hotkeys'}" FontSize="11.5" Foreground="#38BDF8" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassCardStyle}" Padding="16" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Active Script" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Telemetry.ActiveScriptName}" FontSize="20" FontWeight="Bold" Foreground="White"
                                               TextTrimming="CharacterEllipsis" Margin="0,6,0,4" />
                                    <TextBlock FontSize="11.5" Foreground="#A855F7">
                                        <Run Text="Sentence " />
                                        <Run Text="{Binding Telemetry.CurrentSentenceNumber, Mode=OneWay}" />
                                        <Run Text="/" />
                                        <Run Text="{Binding Telemetry.TotalSentences, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassCardStyle}" Padding="16" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Current Typing Speed" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding TypingSpeedLabel}" FontSize="24" FontWeight="Bold" Foreground="#00D4FF" Margin="0,4,0,2" />
                                    <TextBlock Text="Live adjustable during execution" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GlassCardStyle}" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Global Shortcut Hook" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding HookStatusText}" FontSize="18" FontWeight="Bold" Foreground="#22C55E" Margin="0,6,0,4" />
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="Pause: " />
                                        <Run Text="{Binding PauseResumeHotkeyDisplay, Mode=OneWay}" Foreground="White" />
                                        <Run Text="  ·  Stop: " />
                                        <Run Text="{Binding StopHotkeyDisplay, Mode=OneWay}" Foreground="#F43F5E" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Execution Queue & Quick Controls -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="18" Margin="0,0,12,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                        <TextBlock Text="Current Execution Queue" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding QueueCount, StringFormat='{}{0} queued'}"
                                                   FontSize="12" Foreground="#38BDF8" VerticalAlignment="Center" />
                                    </DockPanel>

                                    <ListBox Grid.Row="1" ItemsSource="{Binding QueueItems}" Background="Transparent" BorderThickness="0"
                                             HorizontalContentAlignment="Stretch">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:QueuedScriptSession}">
                                                <Border Background="#660E1B3A" BorderBrush="#3338BDF8" BorderThickness="1"
                                                        CornerRadius="10" Padding="12,9" Margin="0,0,0,8">
                                                    <DockPanel>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding ScriptName}" FontSize="13.5" FontWeight="SemiBold" Foreground="White" />
                                                            <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}">
                                                                <Run Text="Progress: " />
                                                                <Run Text="{Binding ProgressLabel, Mode=OneWay}" Foreground="#38BDF8" />
                                                                <Run Text="  ·  Suspended: " />
                                                                <Run Text="{Binding IsSuspended, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                                                   Text="{Binding RemainingSentences, StringFormat='{}{0} left'}"
                                                                   FontSize="12" Foreground="#A855F7" FontWeight="SemiBold" />
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Engine Command Deck" FontSize="15" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10" />
                                    <TextBlock Text="{Binding Telemetry.StatusMessage}" FontSize="13" Foreground="#38BDF8"
                                               TextWrapping="Wrap" Margin="0,0,0,16" />

                                    <Button Style="{StaticResource ElectricActionButtonStyle}" Height="46" Margin="0,0,0,10"
                                            Command="{Binding StartSelectedScriptCommand}"
                                            Content="Start Selected Script" />
                                    <Button Style="{StaticResource VioletActionButtonStyle}" Height="46" Margin="0,0,0,10"
                                            Command="{Binding PauseResumeCommand}"
                                            Content="{Binding PauseButtonText}" />
                                    <Button Style="{StaticResource CrimsonActionButtonStyle}" Height="46" Margin="0,0,0,16"
                                            Command="{Binding StopAllCommand}"
                                            Content="Stop Immediately &amp; Clear Queue" />

                                    <Border Background="#55070D1E" BorderBrush="#2238BDF8" BorderThickness="1" CornerRadius="10" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="Session Telemetry" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="Hook Latency: " />
                                                <Run Text="{Binding Telemetry.LastHookLatencyMs, StringFormat='{}{0:F2} ms', Mode=OneWay}" Foreground="#22C55E" />
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0">
                                                <Run Text="Last Sentence: " />
                                                <Run Text="{Binding Telemetry.LastSentenceDurationMs, StringFormat='{}{0:F1} ms', Mode=OneWay}" Foreground="#38BDF8" />
                                            </TextBlock>
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0">
                                                <Run Text="Characters Sent: " />
                                                <Run Text="{Binding Telemetry.TotalCharactersTyped, Mode=OneWay}" Foreground="White" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 2. SCRIPTS LIBRARY TAB (Virtualized 300+ Scripts) -->
                    <Border Padding="18">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="{x:Static vm:NavigationTab.ScriptsLibrary}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Scripts Library" FontSize="17" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                    <Border Background="#3300D4FF" BorderBrush="#5500D4FF" BorderThickness="1" CornerRadius="10"
                                            Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalScriptsCount, StringFormat='{}{0} Scripts'}" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBox Style="{StaticResource NeonTextBoxStyle}" Width="260" Margin="0,0,10,0"
                                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Search scripts by name, category, or hotkey" />
                                    <CheckBox Style="{StaticResource NeonSwitchCheckBoxStyle}" Margin="0,0,12,0"
                                              IsChecked="{Binding FilterEnabledOnly}" Content="Enabled Only" />
                                    <Button Style="{StaticResource ElectricActionButtonStyle}"
                                            Command="{Binding AddScriptCommand}" Content="+ New Script" />
                                </StackPanel>
                            </DockPanel>

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding FilteredScripts}"
                                     SelectedItem="{Binding SelectedScript}"
                                     Background="Transparent" BorderThickness="0"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.CanContentScroll="True"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ScriptItem}">
                                        <Border Background="#770C1736" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="10" Padding="14,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" Style="{StaticResource NeonSwitchCheckBoxStyle}"
                                                          IsChecked="{Binding IsEnabled}"
                                                          Command="{Binding DataContext.ToggleScriptEnabledCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}" Margin="0,0,14,0" />

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                                    <TextBlock Text="{Binding PreviewLine}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,2,12,0" />
                                                </StackPanel>

                                                <Border Grid.Column="2" Background="#440284C7" BorderBrush="#7738BDF8" BorderThickness="1"
                                                        CornerRadius="7" Padding="10,4" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding HotkeyDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                                </Border>

                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource GlassButtonStyle}" Margin="0,0,6,0"
                                                            Command="{Binding DataContext.RunSpecificScriptCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Content="Run" />
                                                    <Button Style="{StaticResource GlassButtonStyle}" Margin="0,0,6,0"
                                                            Command="{Binding DataContext.OpenScriptInEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Content="Edit" />
                                                    <Button Style="{StaticResource GlassButtonStyle}" Margin="0,0,6,0"
                                                            Command="{Binding DataContext.DuplicateScriptCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Content="Duplicate" />
                                                    <Button Style="{StaticResource GlassButtonStyle}" BorderBrush="#66EF4444"
                                                            Command="{Binding DataContext.DeleteScriptCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Content="Delete" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- 3. SCRIPT EDITOR TAB (Main Futuristic 3-Column Command Center) -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="{x:Static vm:NavigationTab.ScriptEditor}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="270" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>

                        <!-- LEFT PANEL: Scripts Library Quick List -->
                        <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Padding="14" Margin="0,0,14,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="Scripts Library" FontSize="14.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                    <Border DockPanel.Dock="Right" Background="#3300D4FF" BorderBrush="#6600D4FF" BorderThickness="1" CornerRadius="10" Padding="8,2">
                                        <TextBlock Text="{Binding TotalScriptsCount}" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8" />
                                    </Border>
                                </DockPanel>

                                <TextBox Grid.Row="1" Style="{StaticResource NeonTextBoxStyle}" Margin="0,0,0,10"
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Search Scripts..." />

                                <Button Grid.Row="2" Style="{StaticResource ElectricActionButtonStyle}" Margin="0,0,0,12"
                                        Command="{Binding AddScriptCommand}" Content="+ Add Script" />

                                <ListBox Grid.Row="3"
                                         ItemsSource="{Binding FilteredScripts}"
                                         SelectedItem="{Binding SelectedScript}"
                                         Background="Transparent" BorderThickness="0"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         ScrollViewer.CanContentScroll="True"
                                         HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,6" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="RowBd" Background="#660A132B" BorderBrush="#2638BDF8"
                                                                BorderThickness="1" CornerRadius="9" Padding="10,8" Cursor="Hand">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="RowBd" Property="Background" Value="#667F1D1D" />
                                                                <Setter TargetName="RowBd" Property="BorderBrush" Value="#CCEF4444" />
                                                            </Trigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="RowBd" Property="BorderBrush" Value="#8800D4FF" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ScriptItem}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Background="#551E293B" BorderBrush="#4438BDF8"
                                                        BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding HotkeyDisplay}" FontSize="11" Foreground="White" />
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" Foreground="White"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <DockPanel Grid.Row="4" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding TotalScriptsCount, StringFormat='Total: {0} Scripts'}"
                                               FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource GlassButtonStyle}" Padding="8,4" Margin="0,0,6,0"
                                                Command="{Binding DuplicateScriptCommand}" Content="Duplicate" />
                                        <Button Style="{StaticResource GlassButtonStyle}" Padding="8,4" BorderBrush="#66EF4444"
                                                Command="{Binding DeleteScriptCommand}" Content="Delete" />
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </Border>

                        <!-- CENTER PANEL: Editor Workspace + Start/Pause/Stop Deck -->
                        <Grid Grid.Column="1" Margin="0,0,14,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Script Name + Hotkey Recorder Row -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Script Name:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBox Grid.Column="1" Style="{StaticResource NeonTextBoxStyle}" Margin="0,0,14,0"
                                                 Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" />

                                        <TextBlock Grid.Column="2" Text="Hotkey:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Button Grid.Column="3" Style="{StaticResource GlassButtonStyle}" MinWidth="110" Margin="0,0,6,0"
                                                Command="{Binding RecordSelectedScriptHotkeyCommand}"
                                                Content="{Binding SelectedScriptHotkeyDisplay}"
                                                ToolTip="Click to record a new global shortcut" />
                                        <Button Grid.Column="4" Style="{StaticResource GlassButtonStyle}" Padding="9,6"
                                                Command="{Binding SaveScriptCommand}" Content="Save" />
                                    </Grid>

                                    <!-- Metadata & Toggle Row -->
                                    <DockPanel Grid.Row="1" Margin="0,0,0,10">
                                        <CheckBox Style="{StaticResource NeonSwitchCheckBoxStyle}"
                                                  IsChecked="{Binding EditorIsEnabled}" Content="Hotkey Enabled" />
                                        <TextBlock DockPanel.Dock="Right" FontSize="11.5" Foreground="#38BDF8" VerticalAlignment="Center">
                                            <Run Text="{Binding SelectedScriptSentenceCount, Mode=OneWay}" />
                                            <Run Text=" sentences  ·  " />
                                            <Run Text="{Binding SaveBannerText, Mode=OneWay}" />
                                        </TextBlock>
                                    </DockPanel>

                                    <!-- Multiline Arabic + English + Unicode Script Editor -->
                                    <TextBox Grid.Row="2"
                                             Style="{StaticResource NeonTextBoxStyle}"
                                             Text="{Binding EditorContent, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             FontSize="15"
                                             Padding="14,12" />

                                    <!-- APPEND CONTENT + Direct Paste Bar -->
                                    <Border Grid.Row="3" Background="#66081024" BorderBrush="#338B5CF6" BorderThickness="1"
                                            CornerRadius="10" Padding="10,8" Margin="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0" Style="{StaticResource NeonSwitchCheckBoxStyle}"
                                                      IsChecked="{Binding AppendEnabled}" Content="APPEND CONTENT" Margin="0,0,10,0" />

                                            <TextBox Grid.Column="1" Style="{StaticResource NeonTextBoxStyle}"
                                                     Text="{Binding AppendContent, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,8,0" />

                                            <Button Grid.Column="2" x:Name="EditorEmojiButton" Style="{StaticResource GlassButtonStyle}"
                                                    Margin="0,0,8,0" Command="{Binding ToggleEmojiPickerCommand}" Content="😀 Emoji" />

                                            <CheckBox Grid.Column="3" Style="{StaticResource NeonSwitchCheckBoxStyle}"
                                                      IsChecked="{Binding UseClipboardPasteMode}" Content="Direct Paste" />

                                            <Popup IsOpen="{Binding IsEmojiPickerOpen}" PlacementTarget="{Binding ElementName=EditorEmojiButton}"
                                                   Placement="Top" StaysOpen="False" AllowsTransparency="True">
                                                <Border Background="#EE0C1633" BorderBrush="#AA00D4FF" BorderThickness="1"
                                                        CornerRadius="10" Padding="10" Width="250">
                                                    <ItemsControl ItemsSource="{Binding QuickEmojis}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Style="{StaticResource GlassButtonStyle}" Width="38" Height="34" Padding="0" Margin="3"
                                                                        FontSize="16"
                                                                        Command="{Binding DataContext.InsertEmojiToAppendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" Content="{Binding}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Start / Pause / Stop Futuristic Action Deck -->
                            <UniformGrid Grid.Row="1" Columns="3" Margin="0,12,0,0">
                                <Button Style="{StaticResource ElectricActionButtonStyle}" Height="56" Margin="0,0,10,0"
                                        Command="{Binding StartSelectedScriptCommand}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="▶  Start" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedScriptHotkeyDisplay, StringFormat='{}({0})'}" FontSize="11" Opacity="0.85" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource VioletActionButtonStyle}" Height="56" Margin="0,0,10,0"
                                        Command="{Binding PauseResumeCommand}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding PauseButtonText, StringFormat='⏸  {0}'}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding PauseResumeHotkeyDisplay, StringFormat='{}({0})'}" FontSize="11" Opacity="0.85" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource CrimsonActionButtonStyle}" Height="56"
                                        Command="{Binding StopAllCommand}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="■  Stop" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding StopHotkeyDisplay, StringFormat='{}({0})'}" FontSize="11" Opacity="0.85" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </Grid>

                        <!-- RIGHT PANEL: Speed Control + Repeat Characters + Extras -->
                        <StackPanel Grid.Column="2">
                            <!-- Typing Speed Card -->
                            <Border Style="{StaticResource GlassCardStyle}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="⚡  Typing Speed (MS)" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,12" />

                                    <DockPanel Margin="0,0,0,10">
                                        <TextBox Style="{StaticResource NeonTextBoxStyle}" Width="105" FontSize="18" FontWeight="Bold"
                                                 HorizontalContentAlignment="Center"
                                                 Text="{Binding TypingDelayMs, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="ms" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </DockPanel>

                                    <Slider Minimum="0" Maximum="1000" TickFrequency="10" IsSnapToTickEnabled="False"
                                            Value="{Binding TypingDelayMs, Mode=TwoWay}" />

                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock Text="0 ms" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock DockPanel.Dock="Right" Text="1000 ms" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Repeat Characters Fast Send Card -->
                            <Border Style="{StaticResource GlassCardStyle}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="Aa  Repeat Characters" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource NeonSwitchCheckBoxStyle}"
                                                  IsChecked="{Binding RepeatFastSendEnabled}" />
                                    </DockPanel>
                                    <TextBlock Text="e.g. ههههه → Send Fast" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                                    <DockPanel>
                                        <TextBlock Text="Threshold:" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBox DockPanel.Dock="Right" Style="{StaticResource NeonTextBoxStyle}" Width="70"
                                                 HorizontalContentAlignment="Center"
                                                 Text="{Binding RepeatThreshold, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- Extras / Append Summary Card -->
                            <Border Style="{StaticResource GlassCardStyle}" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="🧩  Extras &amp; Paste Mode" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                                    <TextBlock Text="{Binding AppendModeLabel}" FontSize="12" Foreground="#38BDF8" Margin="0,0,0,10" />
                                    <TextBox Style="{StaticResource NeonTextBoxStyle}"
                                             Text="{Binding AppendContent, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 4. KEYBOARD SHORTCUTS TAB -->
                    <Border Padding="18">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="{x:Static vm:NavigationTab.KeyboardShortcuts}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Global Keyboard Shortcuts &amp; Conflict Guard" FontSize="17" FontWeight="Bold" Foreground="White" Margin="0,0,0,14" />

                            <!-- Global Engine Control Shortcuts -->
                            <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,16">
                                <Border Background="#660E1B3A" BorderBrush="#668B5CF6" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,0">
                                    <DockPanel>
                                        <StackPanel>
                                            <TextBlock Text="Global Pause / Resume Shortcut" FontSize="13.5" FontWeight="SemiBold" Foreground="White" />
                                            <TextBlock Text="Finishes current sentence, sends Enter, pauses cleanly" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource VioletActionButtonStyle}"
                                                Command="{Binding RecordPauseHotkeyCommand}"
                                                Content="{Binding PauseResumeHotkeyDisplay}" />
                                    </DockPanel>
                                </Border>

                                <Border Background="#660E1B3A" BorderBrush="#66EF4444" BorderThickness="1" CornerRadius="10" Padding="14">
                                    <DockPanel>
                                        <StackPanel>
                                            <TextBlock Text="Global Final Stop Shortcut" FontSize="13.5" FontWeight="SemiBold" Foreground="White" />
                                            <TextBlock Text="Immediately cancels execution and clears the queue" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource CrimsonActionButtonStyle}"
                                                Command="{Binding RecordStopHotkeyCommand}"
                                                Content="{Binding StopHotkeyDisplay}" />
                                    </DockPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Script Shortcuts List -->
                            <ListBox Grid.Row="2" ItemsSource="{Binding Scripts}" Background="Transparent" BorderThickness="0"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.CanContentScroll="True" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ScriptItem}">
                                        <Border Background="#660A132B" BorderBrush="#3338BDF8" BorderThickness="1" CornerRadius="9" Padding="12,8" Margin="0,0,0,6">
                                            <DockPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox Style="{StaticResource NeonSwitchCheckBoxStyle}" IsChecked="{Binding IsEnabled}"
                                                              Command="{Binding DataContext.ToggleScriptEnabledCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}" Margin="0,0,12,0" />
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Border Background="#440284C7" BorderBrush="#7738BDF8" BorderThickness="1"
                                                            CornerRadius="6" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding HotkeyDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                                    </Border>
                                                    <Button Style="{StaticResource GlassButtonStyle}" Margin="0,0,6,0"
                                                            Command="{Binding DataContext.RecordScriptRowHotkeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Content="Record Shortcut" />
                                                    <Button Style="{StaticResource GlassButtonStyle}" BorderBrush="#66EF4444"
                                                            Command="{Binding DataContext.ClearScriptHotkeyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" Content="Remove" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- 5. TYPING ENGINE TAB -->
                    <Border Padding="20">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="{x:Static vm:NavigationTab.TypingEngine}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                <TextBlock Text="High-Precision Typing Engine" FontSize="17" FontWeight="Bold" Foreground="White" Margin="0,0,0,14" />

                                <TextBlock Text="Typing Delay (0 ms – 1000 ms)" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <DockPanel Margin="0,0,0,8">
                                    <TextBox Style="{StaticResource NeonTextBoxStyle}" Width="110" FontSize="18" FontWeight="Bold"
                                             Text="{Binding TypingDelayMs, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding TypingSpeedLabel}" FontSize="14" Foreground="#00D4FF" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </DockPanel>
                                <Slider Minimum="0" Maximum="1000" Value="{Binding TypingDelayMs, Mode=TwoWay}" Margin="0,0,0,20" />

                                <CheckBox Style="{StaticResource NeonSwitchCheckBoxStyle}" IsChecked="{Binding RepeatFastSendEnabled}"
                                          Content="Repeated Character Fast Send" Margin="0,0,0,8" />
                                <TextBlock Text="Detects consecutive repeated graphemes (e.g. ههههه) and dispatches them via batched Unicode SendInput without per-character delay."
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="Repetition Threshold:" FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBox Style="{StaticResource NeonTextBoxStyle}" Width="75" Text="{Binding RepeatThreshold, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="APPEND CONTENT &amp; Direct Paste" FontSize="17" FontWeight="Bold" Foreground="White" Margin="0,0,0,14" />
                                <CheckBox Style="{StaticResource NeonSwitchCheckBoxStyle}" IsChecked="{Binding AppendEnabled}"
                                          Content="Append Content to Every Sentence" Margin="0,0,0,10" />
                                <TextBox Style="{StaticResource NeonTextBoxStyle}" Margin="0,0,0,10"
                                         Text="{Binding AppendContent, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Style="{StaticResource NeonSwitchCheckBoxStyle}" IsChecked="{Binding UseClipboardPasteMode}"
                                          Content="Use Direct Clipboard Paste (Preserves User Clipboard)" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding AppendModeLabel}" FontSize="12" Foreground="#38BDF8" Margin="0,0,0,16" />

                                <TextBlock Text="Quick Emoji Insert" FontSize="13" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding QuickEmojis}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource GlassButtonStyle}" Width="38" Height="34" Padding="0" Margin="3" FontSize="15"
                                                    Command="{Binding DataContext.InsertEmojiToAppendCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Content="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 6. SETTINGS TAB -->
                    <Border Padding="20">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="{x:Static vm:NavigationTab.Settings}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <TextBlock Text="Window, Capture &amp; Tray Settings" FontSize="17" FontWeight="Bold" Foreground="White" Margin="0,0,0,14" />

                                <CheckBox Style="{StaticResource NeonSwitchCheckBoxStyle}" IsChecked="{Binding ExcludeFromCapture}"
                                          Content="Exclude Window From Screen Capture (WDA_EXCLUDEFROMCAPTURE)" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding CaptureStatusNote}" FontSize="12" Foreground="#38BDF8" TextWrapping="Wrap" Margin="0,0,0,16" />

                                <CheckBox Style="{StaticResource NeonSwitchCheckBoxStyle}" IsChecked="{Binding MinimizeToTrayOnClose}"
                                          Content="Minimize to Windows System Tray when pressing X" Margin="0,0,0,14" />

                                <CheckBox Style="{StaticResource NeonSwitchCheckBoxStyle}" IsChecked="{Binding EnableBackgroundParticles}"
                                          Content="Enable Subtle Animated Background Particles" Margin="0,0,0,14" />

                                <TextBlock Text="Window Backdrop Material (Windows 10 / 11)" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                    <RadioButton Style="{StaticResource NavTabButtonStyle}" Content="Acrylic" Margin="0,0,6,0"
                                                 IsChecked="{Binding BackdropMaterial, Mode=OneWay, Converter={StaticResource TabEqualityConverter}, ConverterParameter=Acrylic}"
                                                 Click="BackdropAcrylic_Click" />
                                    <RadioButton Style="{StaticResource NavTabButtonStyle}" Content="Mica" Margin="0,0,6,0"
                                                 IsChecked="{Binding BackdropMaterial, Mode=OneWay, Converter={StaticResource TabEqualityConverter}, ConverterParameter=Mica}"
                                                 Click="BackdropMica_Click" />
                                    <RadioButton Style="{StaticResource NavTabButtonStyle}" Content="Midnight Glass"
                                                 IsChecked="{Binding BackdropMaterial, Mode=OneWay, Converter={StaticResource TabEqualityConverter}, ConverterParameter=MidnightGlass}"
                                                 Click="BackdropMidnight_Click" />
                                </StackPanel>

                                <Button Style="{StaticResource CrimsonActionButtonStyle}" HorizontalAlignment="Left"
                                        Click="ExitCompletely_Click" Content="Exit Application Completely" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Data Safety, Backup &amp; JSON Transfer" FontSize="17" FontWeight="Bold" Foreground="White" Margin="0,0,0,10" />
                                <TextBlock Text="{Binding DatabasePath, StringFormat='SQLite Store: {0}'}"
                                           FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />

                                <UniformGrid Columns="2" Margin="0,0,0,12">
                                    <Button Style="{StaticResource ElectricActionButtonStyle}" Margin="0,0,8,8"
                                            Command="{Binding ExportJsonCommand}" Content="Export Scripts (JSON)" />
                                    <Button Style="{StaticResource GlassButtonStyle}" Margin="0,0,0,8"
                                            Command="{Binding ImportJsonCommand}" Content="Import Scripts (JSON)" />
                                    <Button Style="{StaticResource VioletActionButtonStyle}" Margin="0,0,8,0"
                                            Command="{Binding BackupDatabaseCommand}" Content="Backup SQLite DB" />
                                    <Button Style="{StaticResource GlassButtonStyle}"
                                            Command="{Binding RestoreDatabaseCommand}" Content="Restore SQLite DB" />
                                </UniformGrid>

                                <TextBlock Text="{Binding DataOperationStatus}" FontSize="12.5" Foreground="#22C55E" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 7. ABOUT TAB -->
                    <Border Padding="24">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource GlassCardStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTab}" Value="{x:Static vm:NavigationTab.About}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,28,0" HorizontalAlignment="Center">
                                <Border Width="190" Height="190" CornerRadius="95" BorderThickness="3"
                                        BorderBrush="{StaticResource WindowFrameBorderBrush}">
                                    <Border.Clip>
                                        <EllipseGeometry Center="95,95" RadiusX="92" RadiusY="92" />
                                    </Border.Clip>
                                    <Image Source="pack://application:,,,/Resources/owner_portrait.jpg" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Text="POWERED BY PASSION" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"
                                           HorizontalAlignment="Center" Margin="0,12,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="TuSkEer " FontSize="26" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Text="AbDo " FontSize="26" FontWeight="Bold" Foreground="#F43F5E" />
                                    <TextBlock Text="iL PoLiCe" FontSize="26" FontWeight="Bold" Foreground="#38BDF8" />
                                </StackPanel>
                                <TextBlock Text="Professional Windows Auto Typing Engine &amp; Script Manager  ·  .NET 10 WPF"
                                           FontSize="13.5" Foreground="#A855F7" Margin="0,0,0,14" />

                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="20">
                                    Engineered natively for Windows 10 and Windows 11 using Win32 SendInput Unicode injection,
                                    a dedicated low-level WH_KEYBOARD_LL hook thread, SQLite WAL persistent storage,
                                    deterministic priority preemption, and Stopwatch high-resolution delay scheduling.
                                    Screen capture exclusion uses SetWindowDisplayAffinity (WDA_EXCLUDEFROMCAPTURE), whose visibility
                                    protection depends on Windows 10 2004+/Windows 11 and the capture driver used.
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================= ROW 3: BOTTOM STATUS BAR ================= -->
                <Border Grid.Row="3" Background="#99081026" BorderBrush="#3338BDF8" BorderThickness="1"
                        CornerRadius="10" Padding="14,7" Margin="0,12,0,0">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Margin="0,0,8,0"
                                     Fill="{Binding Telemetry.State, Converter={StaticResource EngineStateToBrushConverter}}" />
                            <TextBlock Text="Status: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Telemetry.StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Active Script: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Telemetry.ActiveScriptName}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,14,0" />
                            <TextBlock Text="{Binding QueueCount, StringFormat='Queue: {0}'}" FontSize="12" Foreground="#A855F7" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ================= MODAL OVERLAY: KEYBOARD SHORTCUT RECORDER ================= -->
            <Grid Background="#CC030612"
                  Visibility="{Binding IsRecordingHotkey, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Style="{StaticResource GlassCardStyle}" Width="460" Padding="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BorderBrush="{StaticResource ElectricCyanBrush}">
                    <StackPanel>
                        <TextBlock Text="Record Global Keyboard Shortcut" FontSize="17" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="{Binding RecordingTargetLabel}" FontSize="13" Foreground="#38BDF8" Margin="0,4,0,14" />

                        <Border Background="#99050917" BorderBrush="#668B5CF6" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                            <TextBlock Text="{Binding RecordingPromptText}" FontSize="14" FontWeight="SemiBold" Foreground="White"
                                       TextAlignment="Center" TextWrapping="Wrap" />
                        </Border>

                        <Border Background="#557F1D1D" BorderBrush="#CCEF4444" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12"
                                Visibility="{Binding HasShortcutConflict, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding ShortcutConflictWarning}" FontSize="12" Foreground="#FCA5A5" TextWrapping="Wrap" />
                        </Border>

                        <DockPanel>
                            <Button Style="{StaticResource GlassButtonStyle}" Command="{Binding CancelRecordingHotkeyCommand}" Content="Cancel" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource ElectricActionButtonStyle}"
                                    Command="{Binding ConfirmRecordedHotkeyCommand}" Content="Confirm Shortcut" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
